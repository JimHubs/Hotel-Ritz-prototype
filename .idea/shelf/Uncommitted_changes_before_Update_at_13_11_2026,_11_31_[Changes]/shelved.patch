<+>\n.dashboard {\n    --green: #35483d;\n    --green-light: #e8eee8;\n    --cream: #f7f6f1;\n    --text: #343b35;\n    --muted: #858a82;\n\n    display: flex;\n    min-height: 100vh;\n    background: var(--cream);\n    color: var(--text);\n    font-family: Arial, sans-serif;\n}\n\n/* Sidebar */\n\n.sidebar {\n    width: 250px;\n    min-width: 250px;\n    background: var(--green);\n    color: white;\n    display: flex;\n    flex-direction: column;\n    padding: 35px 22px;\n}\n\n.brand {\n    display: flex;\n    flex-direction: column;\n    padding: 0 12px 45px;\n}\n\n.brand-name {\n    font-family: Georgia, serif;\n    font-size: 25px;\n    letter-spacing: 4px;\n}\n\n.brand-subtitle {\n    margin-top: 8px;\n    font-size: 9px;\n    letter-spacing: 2px;\n    color: #c2cec3;\n}\n\n.sidebar-nav {\n    display: flex;\n    flex-direction: column;\n    gap: 8px;\n}\n\n.nav-heading {\n    color: #aab8ab;\n    font-size: 10px;\n    letter-spacing: 2px;\n    margin: 0 12px 12px;\n}\n\n.nav-link {\n    display: flex;\n    align-items: center;\n    gap: 13px;\n    padding: 13px 14px;\n    color: #dce3dc;\n    text-decoration: none;\n    border-radius: 6px;\n    font-size: 14px;\n}\n\n.nav-link span {\n    font-size: 19px;\n}\n\n.nav-link:hover,\n.nav-link.active {\n    background: #506657;\n    color: white;\n}\n\n.account-heading {\n    margin-top: 35px;\n}\n\n.sidebar-bottom {\n    margin-top: auto;\n}\n\n.sidebar-user {\n    display: flex;\n    align-items: center;\n    gap: 12px;\n    padding: 20px 5px 0;\n    border-top: 1px solid #607065;\n}\n\n.user-avatar {\n    width: 38px;\n    height: 38px;\n    background: #d9d5c5;\n    color: var(--green);\n    display: grid;\n    place-items: center;\n    border-radius: 50%;\n    font-weight: bold;\n}\n\n.sidebar-user strong,\n.sidebar-user span {\n    display: block;\n    font-size: 12px;\n}\n\n.sidebar-user span {\n    color: #b9c5ba;\n    margin-top: 5px;\n}\n\n/* Main content */\n\n.main-content {\n    flex: 1;\n    min-width: 0;\n    padding: 0 55px;\n}\n\n.topbar {\n    height: 85px;\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    border-bottom: 1px solid #e8e6de;\n}\n\n.breadcrumb {\n    color: var(--muted);\n    font-size: 13px;\n}\n\n.profile-link {\n    color: var(--green);\n    text-decoration: none;\n    font-size: 13px;\n    font-weight: bold;\n}\n\n/* Welcome */\n\n.welcome-section {\n    margin-top: 45px;\n    padding: 40px;\n    background: #e9ece4;\n    border-radius: 10px;\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    overflow: hidden;\n}\n\n.section-label {\n    font-size: 10px;\n    letter-spacing: 2px;\n    color: #758676;\n    font-weight: bold;\n}\n\n.welcome-section h1 {\n    font-family: Georgia, serif;\n    font-size: 36px;\n    font-weight: normal;\n    margin: 15px 0;\n}\n\n.welcome-section p {\n    color: #72796f;\n    font-size: 14px;\n    line-height: 1.7;\n}\n\n.welcome-decoration {\n    font-family: Georgia, serif;\n    font-size: 90px;\n    color: #d2d9cf;\n    padding: 0 25px;\n}\n\n/* Overview */\n\n.overview-section,\n.announcements-section {\n    margin-top: 45px;\n}\n\n.section-heading {\n    display: flex;\n    justify-content: space-between;\n    align-items: center;\n    margin-bottom: 22px;\n}\n\n.section-heading h2 {\n    font-family: Georgia, serif;\n    font-size: 25px;\n    font-weight: normal;\n    margin: 0;\n}\n\n.section-heading p {\n    color: var(--muted);\n    font-size: 13px;\n    margin-top: 8px;\n}\n\n.overview-grid {\n    display: grid;\n    grid-template-columns: repeat(3, 1fr);\n    gap: 20px;\n}\n\n.overview-card {\n    background: white;\n    padding: 25px;\n    border: 1px solid #eeece5;\n    border-radius: 8px;\n}\n\n.card-icon {\n    width: 42px;\n    height: 42px;\n    display: grid;\n    place-items: center;\n    background: var(--green-light);\n    color: var(--green);\n    border-radius: 8px;\n    font-size: 22px;\n    margin-bottom: 22px;\n}\n\n.card-label {\n    font-size: 9px;\n    letter-spacing: 1.5px;\n    color: #899488;\n}\n\n.overview-card h3 {\n    font-family: Georgia, serif;\n    font-size: 21px;\n    font-weight: normal;\n    margin: 10px 0;\n}\n\n.overview-card p {\n    font-size: 12px;\n    color: var(--muted);\n    line-height: 1.7;\n    min-height: 40px;\n}\n\n.overview-card a,\n.view-all {\n    display: inline-block;\n    margin-top: 12px;\n    color: #526b55;\n    font-size: 12px;\n    font-weight: bold;\n    text-decoration: none;\n}\n\n.overview-card a:hover,\n.view-all:hover {\n    text-decoration: underline;\n}\n\n/* Announcements */\n\n.announcement-placeholder {\n    background: white;\n    border: 1px solid #eeece5;\n    border-radius: 8px;\n    padding: 45px 20px;\n    text-align: center;\n}\n\n.empty-icon {\n    color: #849482;\n    font-size: 35px;\n}\n\n.announcement-placeholder h3 {\n    font-family: Georgia, serif;\n    font-weight: normal;\n    font-size: 21px;\n    margin: 15px 0 8px;\n}\n\n.announcement-placeholder p {\n    color: var(--muted);\n    font-size: 13px;\n    line-height: 1.7;\n}\n\n.dashboard-footer {\n    display: flex;\n    justify-content: space-between;\n    padding: 35px 0;\n    margin-top: 35px;\n    border-top: 1px solid #e8e6de;\n    color: var(--muted);\n    font-size: 10px;\n    letter-spacing: 1px;\n}\n\n/* Responsive */\n\n@media (max-width: 1000px) {\n    .main-content {\n        padding: 0 25px;\n    }\n\n    .overview-grid {\n        grid-template-columns: 1fr;\n    }\n}\n\n@media (max-width: 650px) {\n    .dashboard {\n        flex-direction: column;\n    }\n\n    .sidebar {\n        width: auto;\n        min-width: 0;\n        padding: 20px;\n    }\n\n    .sidebar-bottom {\n        display: none;\n    }\n\n    .sidebar-nav {\n        flex-direction: row;\n        flex-wrap: wrap;\n    }\n\n    .nav-heading {\n        width: 100%;\n    }\n\n    .account-heading {\n        margin-top: 10px;\n    }\n\n    .main-content {\n        padding: 0 18px;\n    }\n\n    .welcome-section {\n        padding: 25px;\n    }\n\n    .welcome-section h1 {\n        font-size: 28px;\n    }\n\n    .welcome-decoration {\n        display: none;\n    }\n\n    .dashboard-footer {\n        gap: 15px;\n        flex-wrap: wrap;\n    }\n}\n
