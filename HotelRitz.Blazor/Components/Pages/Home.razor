
@page "/"
@using HotelRitz.Blazor.Services
@using HotelRitz.Blazor.Data.Model
@inject OpslagService Service
@layout HotelRitz.Blazor.Components.Layout.EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Hotel Ritz | Dashboard</PageTitle>

<header class="topbar">
    <div>
        <span class="breadcrumb">
            Hotel Ritz / Dashboard
        </span>
    </div>

    <a href="/Account/Manage" class="profile-link">
        Min profil
    </a>
</header>

<section class="welcome-section">
    <div>
        <span class="section-label">
            MEDARBEJDERPORTAL
        </span>

        <h1>Velkommen til Hotel Ritz</h1>

        <p>
            Her finder du de seneste informationer,
            nyheder og beskeder fra hotellet.
        </p>
    </div>

    <div class="welcome-decoration">
        HR
    </div>
</section>

<section class="overview-section">
    <div class="section-heading">
        <div>
            <h2>Overblik</h2>
            <p>
                Et hurtigt overblik over medarbejderportalen.
            </p>
        </div>
    </div>

    <div class="overview-grid">
        <article class="overview-card">
            <div class="card-icon">▤</div>
            <span class="card-label">OPSLAGSTAVLE</span>
            <h3>Seneste opslag</h3>
            <p>
                Hold dig opdateret med hotellets nyheder.
            </p>
            <a href="/opslagstavle">Se opslag →</a>
        </article>

        <article class="overview-card">
            <div class="card-icon">♙</div>
            <span class="card-label">TEAMET</span>
            <h3>Medarbejdere</h3>
            <p>
                Få et overblik over hotellets medarbejdere.
            </p>
            <a href="/medarbejdere">Se medarbejdere →</a>
        </article>

        <article class="overview-card">
            <div class="card-icon">▦</div>
            <span class="card-label">ARBEJDSTID</span>
            <h3>Vagtplan</h3>
            <p>
                Find information om dine vagter og arbejdstider.
            </p>
            <a href="/vagtplan">Se vagtplan →</a>
        </article>
    </div>
</section>

<section class="announcements-section">
    <div class="section-heading">
        <div>
            <h2>Seneste opslag</h2>
            <p>
                Information og beskeder fra Hotel Ritz.
            </p>
        </div>

        <a href="/opslagstavle" class="view-all">
            Se alle opslag →
        </a>
    </div>

    @{
        var senesteOpslag = Service.HentAlleOpslag()
            .OrderByDescending(o => o.Oprettelsesdato)
            .Take(3)
            .ToList();
    }

    @if (senesteOpslag.Any())
    {
        <div class="announcement-grid">
            @foreach (var opslag in senesteOpslag)
            {
                <article class="announcement-card">
                    <div class="announcement-card-header">
                        <div>
                            <h3>@opslag.Titel</h3>

                            <span class="announcement-meta">
                                Af @opslag.Forfatter
                                · @opslag.Oprettelsesdato.ToString("dd.MM.yyyy")
                            </span>
                        </div>

                        @if (opslag.ErFaerdiggjort)
                        {
                            <span class="announcement-status">
                                Afsluttet
                            </span>
                        }
                    </div>

                    <div class="announcement-message">
                        @opslag.Besked
                    </div>
                </article>
            }
        </div>
    }
    else
    {
        <div class="announcement-placeholder">
            <div class="empty-icon">▤</div>

            <h3>Ingen opslag endnu</h3>

            <p>
                Når der bliver oprettet opslag på
                opslagstavlen, vil de blive vist her.
            </p>
        </div>
    }
</section>

<footer class="dashboard-footer">
    <span>HOTEL RITZ</span>
    <span>Intern medarbejderportal</span>
</footer>
