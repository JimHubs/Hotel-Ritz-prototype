
@page "/"
@layout HotelRitz.Blazor.Components.Layout.EmptyLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>Hotel Ritz | Dashboard</PageTitle>

<div class="dashboard">

    <aside class="sidebar">

        <div class="brand">
            <img src="/images/milling-hotels-logo.png"
                 alt="Milling Hotels"
                 class="brand-logo" />

            <span class="brand-subtitle">
                HOTEL RITZ · MEDARBEJDERPORTAL
            </span>
        </div>

        <nav class="sidebar-nav">

            <span class="nav-heading">MENU</span>

            <a href="/" class="nav-link active">
                <span>⌂</span> Dashboard
            </a>

            <a href="/opslagstavle" class="nav-link">
                <span>▤</span> Opslagstavle
            </a>

            <a href="/medarbejdere" class="nav-link">
                <span>♙</span> Medarbejdere
            </a>

            <a href="/vagtplan" class="nav-link">
                <span>▦</span> Vagtplan
            </a>

            <span class="nav-heading account-heading">KONTO</span>

            <a href="/Account/Manage" class="nav-link">
                <span>⚙</span> Min profil
            </a>

        </nav>

        <div class="sidebar-bottom">
            <div class="sidebar-user">

                <div class="user-avatar">HR</div>

                <div>
                    <strong>Medarbejder</strong>
                    <span>Hotel Ritz</span>
                </div>

            </div>
        </div>

    </aside>

    <main class="main-content">

        <header class="topbar">

            <div>
                <span class="breadcrumb">
                    Hotel Ritz / Dashboard
                </span>
            </div>

            <a href="/Account/Manage" class="profile-link">
                Min profil
            </a>

        </header>

        <section class="welcome-section">

            <div>
                <span class="section-label">
                    MEDARBEJDERPORTAL
                </span>

                <h1>Velkommen til Hotel Ritz</h1>

                <p>
                    Her finder du de seneste informationer,
                    nyheder og beskeder fra hotellet.
                </p>
            </div>

            <div class="welcome-decoration">
                HR
            </div>

        </section>

        <section class="overview-section">

            <div class="section-heading">

                <div>
                    <h2>Overblik</h2>
                    <p>
                        Et hurtigt overblik over medarbejderportalen.
                    </p>
                </div>

            </div>

            <div class="overview-grid">

                <article class="overview-card">

                    <div class="card-icon">▤</div>

                    <span class="card-label">
                        OPSLAGSTAVLE
                    </span>

                    <h3>Seneste opslag</h3>

                    <p>
                        Hold dig opdateret med hotellets nyheder.
                    </p>

                    <a href="/opslagstavle">
                        Se opslag →
                    </a>

                </article>

                <article class="overview-card">

                    <div class="card-icon">♙</div>

                    <span class="card-label">
                        TEAMET
                    </span>

                    <h3>Medarbejdere</h3>

                    <p>
                        Få et overblik over hotellets medarbejdere.
                    </p>

                    <a href="/medarbejdere">
                        Se medarbejdere →
                    </a>

                </article>

                <article class="overview-card">

                    <div class="card-icon">▦</div>

                    <span class="card-label">
                        ARBEJDSTID
                    </span>

                    <h3>Vagtplan</h3>

                    <p>
                        Find information om dine vagter og arbejdstider.
                    </p>

                    <a href="/vagtplan">
                        Se vagtplan →
                    </a>

                </article>

            </div>

        </section>

        <section class="announcements-section">

            <div class="section-heading">

                <div>
                    <h2>Seneste opslag</h2>
                    <p>
                        Information og beskeder fra Hotel Ritz.
                    </p>
                </div>

                <a href="/opslagstavle" class="view-all">
                    Se alle opslag →
                </a>

            </div>

            <div class="announcement-placeholder">

                <div class="empty-icon">▤</div>

                <h3>Ingen opslag endnu</h3>

                <p>
                    Når der bliver oprettet opslag på
                    opslagstavlen, vil de blive vist her.
                </p>

            </div>

        </section>

        <footer class="dashboard-footer">

            <span>HOTEL RITZ</span>

            <span>Intern medarbejderportal</span>

        </footer>

    </main>

</div>
